{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tue:dsai:admission-output:v1",
  "title": "DS&AI admission application output",
  "description": "Machine-readable output generated by the offline DS&AI additional admissions form.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outputSchemaVersion",
    "formVersion",
    "generatedAt",
    "applicant",
    "previousStudies",
    "courses",
    "prerequisiteCoverage",
    "generationWarnings"
  ],
  "properties": {
    "outputSchemaVersion": {
      "const": "1"
    },
    "formVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{4}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "applicant": {
      "$ref": "#/$defs/applicant"
    },
    "previousStudies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/previousStudy"
      }
    },
    "courses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/course"
      }
    },
    "prerequisiteCoverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/prerequisiteRequirement"
      }
    },
    "generationWarnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/generationWarning"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "formVersion": {
            "const": "2026-2027"
          }
        },
        "required": ["formVersion"]
      },
      "then": {
        "properties": {
          "previousStudies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "gradingSystem": {
                  "not": {
                    "const": "pass_fail"
                  }
                }
              },
              "not": {
                "required": ["creditSystemOther"]
              }
            }
          },
          "courses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["courseEC", "isPassFail"],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "isPassFail": {
                        "const": true
                      }
                    },
                    "required": ["isPassFail"]
                  },
                  "then": {
                    "properties": {
                      "finalGrade": {
                        "type": "null"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "finalGrade": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "formVersion": {
            "const": "2025-2026"
          }
        },
        "required": ["formVersion"]
      },
      "then": {
        "properties": {
          "previousStudies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["creditSystemOther"]
            }
          },
          "courses": {
            "type": "array",
            "items": {
              "type": "object",
              "not": {
                "required": ["isPassFail"]
              },
              "properties": {
                "finalGrade": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "applicant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullName", "tueStudentNumber"],
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 1
        },
        "tueStudentNumber": {
          "type": "string",
          "pattern": "^[0-9]{7}$"
        }
      }
    },
    "previousStudy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "studyReference",
        "degreeProgrammeName",
        "graduationDate",
        "universityName",
        "city",
        "country",
        "fullTimeEquivalentDurationYears",
        "totalDegreeCredits",
        "creditSystem",
        "gradingSystem",
        "gradingSystemInformation",
        "bestGrade",
        "minimumPassingGrade"
      ],
      "properties": {
        "studyReference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$"
        },
        "degreeProgrammeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "graduationDate": {
          "type": "string",
          "format": "date"
        },
        "universityName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "country": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "fullTimeEquivalentDurationYears": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "totalDegreeCredits": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "creditSystem": {
          "type": "string",
          "enum": [
            "ects",
            "us_semester_credits",
            "us_quarter_credits",
            "uk_cats",
            "other"
          ]
        },
        "creditSystemOther": {
          "type": ["string", "null"],
          "maxLength": 120
        },
        "gradingSystem": {
          "type": "string",
          "enum": [
            "numeric_higher_better",
            "numeric_lower_better",
            "letter_grades",
            "pass_fail",
            "other"
          ]
        },
        "gradingSystemInformation": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "bestGrade": {
          "type": ["string", "null"],
          "maxLength": 120
        },
        "minimumPassingGrade": {
          "type": ["string", "null"],
          "maxLength": 120
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "creditSystem": {
                "const": "other"
              }
            },
            "required": ["creditSystem"]
          },
          "then": {
            "properties": {
              "creditSystemOther": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "creditSystemOther": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "gradingSystem": {
                "enum": ["letter_grades", "other"]
              }
            },
            "required": ["gradingSystem"]
          },
          "then": {
            "properties": {
              "gradingSystemInformation": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "gradingSystemInformation": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "gradingSystem": {
                "const": "pass_fail"
              }
            },
            "required": ["gradingSystem"]
          },
          "then": {
            "properties": {
              "bestGrade": {
                "type": "null"
              },
              "minimumPassingGrade": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "bestGrade": {
                "type": "string",
                "minLength": 1
              },
              "minimumPassingGrade": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "courseReference",
        "degreeReference",
        "courseTitle",
        "courseCode",
        "credits",
        "finalGrade",
        "officialDescription"
      ],
      "properties": {
        "courseReference": {
          "type": "string",
          "minLength": 4,
          "maxLength": 400
        },
        "degreeReference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$"
        },
        "courseTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "courseCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "credits": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "courseEC": {
          "description": "Course credits converted to European Credits (EC) for form versions that enable automatic conversion.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "isPassFail": {
          "description": "Whether the course was assessed on a Pass/Fail basis.",
          "type": "boolean"
        },
        "finalGrade": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 120
        },
        "officialDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    },
    "prerequisiteRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementReference",
        "requirementTitle",
        "topics",
        "courseEvidence"
      ],
      "properties": {
        "requirementReference": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "requirementTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "topics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "courseEvidence": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/courseEvidence"
          }
        }
      }
    },
    "courseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "courseReference",
        "topicsCovered",
        "additionalExplanation"
      ],
      "properties": {
        "courseReference": {
          "type": "string",
          "minLength": 4,
          "maxLength": 400
        },
        "topicsCovered": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "additionalExplanation": {
          "type": ["string", "null"],
          "maxLength": 4000
        }
      }
    },
    "generationWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "message"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
