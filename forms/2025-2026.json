{
  "title": "Additional Admissions Form",
  "showTitle": false,
  "showQuestionNumbers": "on",
  "questionTitleLocation": "top",
  "checkErrorsMode": "onValueChanged",
  "widthMode": "responsive",
  "showProgressBar": "top",
  "progressBarType": "pages",
  "completeText": "Create report",
  "showCompletePage": false,
  "pages": [
    {
      "name": "applicant_details",
      "title": "Applicant details",
      "description": "This form will help you create an additional documentation for your DSAI application documentation. You need to fill in the form, use it to generate a PDF, and upload this PDF in Osiris.",
      "elements": [
        {
          "type": "multipletext",
          "name": "personal_info",
          "title": "Personal information",
          "description": "Enter the details exactly as they appear in your application.",
          "showNumber": false,
          "isRequired": true,
          "items": [
            {
              "name": "name",
              "isRequired": true,
              "placeholder": "Surname, Given name(s)",
              "title": "Name"
            },
            {
              "name": "id",
              "isRequired": true,
              "maskType": "pattern",
              "maskSettings": {
                "pattern": "9999999"
              },
              "title": "Student ID",
              "maxLength": 7,
              "inputSize": 7,
              "validators": [
                {
                  "type": "regex",
                  "text": "Your id is a 7-digit number",
                  "regex": "\\d{7}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "previous_studies_page",
      "title": "Previous studies",
      "elements": [
        {
          "type": "paneldynamic",
          "name": "previous_studies",
          "title": "Previous studies",
          "description": "Provide the degree that is most relevant to this application. You may add a second relevant degree.",
          "showNumber": false,
          "isRequired": true,
          "panelCount": 1,
          "minPanelCount": 1,
          "maxPanelCount": 2,
          "templateTitle": "Degree {panelIndex}{panel.degree_heading_suffix}",
          "templateDescription": "{panel.university_name}",
          "panelsState": "firstExpanded",
          "addPanelText": "Add another degree",
          "removePanelText": "Remove degree",
          "confirmDelete": true,
          "confirmDeleteText": "Remove this degree and all information entered for it?",
          "templateElements": [
            {
              "type": "text",
              "name": "degree_programme_name",
              "title": "Degree programme name",
              "placeholder": "For example, Bachelor of Computer Science",
              "isRequired": true,
              "maxLength": 250,
              "width": "100%"
            },
            {
              "type": "expression",
              "name": "degree_heading_suffix",
              "expression": "iif({panel.degree_programme_name} notempty, ': ' + {panel.degree_programme_name}, '')",
              "visible": false
            },
            {
              "type": "expression",
              "name": "degree_ref",
              "visible": false,
              "clearIfInvisible": "none",
              "expression": "'degree-' + ({panelIndex} + 1)"
            },
            {
              "type": "expression",
              "name": "degree_label",
              "visible": false,
              "clearIfInvisible": "none",
              "expression": "'Degree ' + ({panelIndex} + 1) + ': ' + {panel.degree_programme_name} + iif({panel.university_name} notempty, ' (' + {panel.university_name} + ')', '')"
            },
            {
              "type": "text",
              "name": "university_name",
              "title": "University name",
              "placeholder": "Official university name",
              "isRequired": true,
              "maxLength": 250,
              "width": "100%"
            },
            {
              "type": "text",
              "name": "country",
              "title": "Country",
              "isRequired": true,
              "maxLength": 120,
              "width": "50%"
            },
            {
              "type": "text",
              "name": "city",
              "title": "City",
              "isRequired": true,
              "maxLength": 120,
              "width": "50%",
              "startWithNewLine": false
            },
            {
              "type": "text",
              "name": "graduation_date",
              "title": "Expected or completed graduation date",
              "description": "Enter the actual date or your best current estimate.",
              "inputType": "date",
              "isRequired": true,
              "width": "50%"
            },
            {
              "type": "text",
              "name": "total_degree_credits",
              "title": "Total degree credits (ECTS)",
              "description": "Enter the ECTS equivalent if another credit system is used.",
              "maskType": "numeric",
              "maskSettings": {
                "min": 1,
                "max": 10000,
                "precision": 1
              },
              "placeholder": "For example, 180",
              "isRequired": true,
              "width": "50%",
              "startWithNewLine": false
            }
          ]
        }
      ]
    },
    {
      "name": "relevant_courses_page",
      "title": "Relevant courses",
      "description": "Add every course you want to use as evidence for the admission requirements. Add each course only once. On the following pages, you will select which requirements each course supports.",
      "elements": [
        {
          "type": "paneldynamic",
          "name": "relevant_courses",
          "titleLocation": "hidden",
          "showNumber": false,
          "isRequired": true,
          "panelCount": 1,
          "minPanelCount": 1,
          "maxPanelCount": 30,
          "panelsState": "firstExpanded",
          "confirmDelete": true,
          "confirmDeleteText": "Remove this course and all information entered for it?",
          "addPanelText": "Add another course",
          "removePanelText": "Remove course",
          "keyName": "course_ref",
          "keyDuplicationError": "Add each course only once for a degree.",
          "templateTitle": "Course {panelIndex}",
          "templateDescription": "{panel.course_label}",
          "templateElements": [
            {
              "type": "dropdown",
              "name": "degree_ref",
              "title": "Degree",
              "description": "Select the degree that contains this course.",
              "placeholder": "Select a degree",
              "isRequired": true,
              "choicesFromQuestion": "previous_studies",
              "choiceValuesFromQuestion": "degree_ref",
              "choiceTextsFromQuestion": "degree_label",
              "width": "100%"
            },
            {
              "type": "text",
              "name": "course_title",
              "title": "Course title",
              "placeholder": "Official course title",
              "isRequired": true,
              "maxLength": 250,
              "width": "65%"
            },
            {
              "type": "text",
              "name": "course_code",
              "title": "Course code",
              "placeholder": "For example, MATH101",
              "isRequired": true,
              "maxLength": 100,
              "width": "30%",
              "startWithNewLine": false
            },
            {
              "type": "text",
              "name": "final_grade",
              "title": "Final grade",
              "description": "Leave this blank if a final grade is not yet available.",
              "placeholder": "For example, 8.5 or A",
              "maxLength": 120,
              "width": "50%"
            },
            {
              "type": "text",
              "name": "course_credits",
              "title": "Course credits",
              "description": "Use the same credit system as the selected degree.",
              "maskType": "numeric",
              "maskSettings": {
                "min": 0.1,
                "max": 10000,
                "precision": 1
              },
              "placeholder": "For example, 5",
              "isRequired": true,
              "width": "45%",
              "startWithNewLine": false
            },
            {
              "type": "comment",
              "name": "official_course_description",
              "title": "Official course description",
              "description": "Copy the official description from the university study guide or course catalogue. If available, include the link to the official course page or catalogue.",
              "isRequired": true,
              "autoGrow": true,
              "rows": 6,
              "maxLength": 20000,
              "width": "100%"
            },
            {
              "type": "expression",
              "name": "course_ref",
              "visible": false,
              "clearIfInvisible": "none",
              "expression": "{panel.degree_ref} + '::' + {panel.course_code}"
            },
            {
              "type": "expression",
              "name": "course_label",
              "visible": false,
              "clearIfInvisible": "none",
              "expression": "{panel.course_code} + ' ' + {panel.course_title}"
            }
          ]
        }
      ]
    },
